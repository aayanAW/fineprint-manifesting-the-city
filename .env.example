# FinePrint v2 environment.
# AI key is OPTIONAL — with no key, AI routes run a deterministic fallback and
# the plan badge reads "estimated". Set it to make Claude live ("AI-ranked").
ANTHROPIC_API_KEY=

# Optional: raises the NYC Open Data (Socrata) rate limit for LL84 fetches.
SOCRATA_APP_TOKEN=

# Optional: override the model (default claude-opus-4-8).
ANTHROPIC_MODEL=
